
{
  "expo": {
    "name": "LovableCar",
    "slug": "lovable-car-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/splash-icon.png",
    "scheme": "lovablecarmobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/lovablecarlogo.png",
      "bundleIdentifier": "com.alextukaylo.lovable-car-mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/splash-icon.png",
        "backgroundImage": "./assets/images/splash-icon.png",
        "monochromeImage": "./assets/images/splash-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/lovablecarlogo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/lovablecar-main-background.png",
          "imageWidth": 400,
          "resizeMode": "cover",
          "backgroundColor": "#DDF2FF",
          "dark": {
            "image": "./assets/images/lovablecar-main-background.png",
            "backgroundColor": "#DDF2FF"
          }
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "LovableCar needs access to your camera to scan service documents."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
